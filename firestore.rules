rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/adminUsers/$(request.auth.uid))
        && get(/databases/$(database)/documents/adminUsers/$(request.auth.uid)).data.active == true;
    }

    function hasValidBookingReference() {
      return request.resource.data.referenceGalleryItemId == '' || (
        exists(/databases/$(database)/documents/gallery/$(request.resource.data.referenceGalleryItemId))
        && get(/databases/$(database)/documents/gallery/$(request.resource.data.referenceGalleryItemId)).data.isPublished == true
        && request.resource.data.referenceImageUrl == get(/databases/$(database)/documents/gallery/$(request.resource.data.referenceGalleryItemId)).data.imageUrl
        && request.resource.data.referenceCaption == get(/databases/$(database)/documents/gallery/$(request.resource.data.referenceGalleryItemId)).data.caption
      );
    }

    function hasValidBookingService() {
      return exists(/databases/$(database)/documents/services/$(request.resource.data.serviceId))
        && get(/databases/$(database)/documents/services/$(request.resource.data.serviceId)).data.isActive == true
        && request.resource.data.serviceName == get(/databases/$(database)/documents/services/$(request.resource.data.serviceId)).data.name;
    }

    function hasAllowedAdminBookingTransition() {
      return isAdmin()
        && request.resource.data.diff(resource.data).changedKeys()
          .hasOnly(['status', 'adminUpdatedAt'])
        && request.resource.data.paymentStatus == resource.data.paymentStatus
        && (
          (resource.data.status == 'prepared'
            && resource.data.paymentStatus == 'not_required'
            && request.resource.data.status in ['accepted', 'declined', 'cancelled'])
          || (resource.data.status == 'accepted'
            && resource.data.paymentStatus == 'not_required'
            && request.resource.data.status == 'cancelled')
        );
    }

    match /adminUsers/{userId} {
      allow get: if signedIn() && request.auth.uid == userId;
      allow list: if false;
      allow create, update, delete: if isAdmin();
    }

    match /businessSettings/main {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /services/{serviceId} {
      allow read: if isAdmin() || resource.data.isActive == true;
      allow write: if isAdmin();
    }

    match /gallery/{galleryId} {
      allow read: if isAdmin() || resource.data.isPublished == true;
      allow write: if isAdmin();
    }

    match /homepageContent/{contentId} {
      allow read: if isAdmin() || resource.data.isPublished == true;
      allow write: if isAdmin();
    }

    match /bookings/{bookingId} {
      allow read: if isAdmin();
      allow create: if isAdmin() || (
        request.resource.data.keys().hasOnly(['customerName', 'customerPhone', 'customerEmail', 'serviceId', 'serviceName', 'preferredDate', 'preferredTime', 'referenceGalleryItemId', 'referenceImageUrl', 'referenceCaption', 'status', 'paymentStatus', 'createdAt'])
        && request.resource.data.customerName is string
        && request.resource.data.customerName.size() >= 1
        && request.resource.data.customerName.size() <= 100
        && request.resource.data.customerPhone is string
        && request.resource.data.customerPhone.size() >= 3
        && request.resource.data.customerPhone.size() <= 40
        && request.resource.data.customerEmail is string
        && request.resource.data.customerEmail.size() >= 3
        && request.resource.data.customerEmail.size() <= 160
        && request.resource.data.serviceId is string
        && request.resource.data.serviceId.size() >= 1
        && request.resource.data.serviceId.size() <= 200
        && request.resource.data.serviceName is string
        && request.resource.data.serviceName.size() >= 1
        && request.resource.data.serviceName.size() <= 120
        && hasValidBookingService()
        && request.resource.data.preferredDate is string
        && request.resource.data.preferredTime is string
        && request.resource.data.referenceGalleryItemId is string
        && request.resource.data.referenceGalleryItemId.size() <= 200
        && request.resource.data.referenceImageUrl is string
        && request.resource.data.referenceImageUrl.size() <= 2000
        && request.resource.data.referenceCaption is string
        && request.resource.data.referenceCaption.size() <= 240
        && hasValidBookingReference()
        && request.resource.data.status == 'prepared'
        && request.resource.data.paymentStatus == 'not_required'
        && request.resource.data.createdAt == request.time
      );
      allow update: if hasAllowedAdminBookingTransition();
      allow delete: if false;
    }

    match /reviews/{reviewId} {
      allow read: if isAdmin() || resource.data.published == true;
      allow create: if isAdmin() || (
        request.resource.data.keys().hasOnly(['rating', 'review', 'displayName', 'createdAt', 'published'])
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.review is string
        && request.resource.data.review.size() >= 1
        && request.resource.data.review.size() <= 1000
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 80
        && request.resource.data.published == false
        && request.resource.data.createdAt == request.time
      );
      allow update, delete: if isAdmin();
    }
  }
}
